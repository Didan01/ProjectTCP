[
  {
    "method": "Создание чата",
    "request": {
      "command": "create_chat",
      "sender_id": "1",
      "args": { "chat_name": "Название чата" }
    },
    "response": {
      "command": "new_chat",
      "args": { 
        "chat": "{\"chat_id\":10, \"chat_name\":\"Название чата\"}" 
      }
    }
  },
  {
    "method": "Добавление участника",
    "request": {
      "command": "add_member",
      "sender_id": "1",
      "args": { "user_id": "5", "chat_id": "2" }
    },
    "response": {
      "command": "added_to_chat",
      "args": { 
        "user": "{\"user_id\":5, \"user_name\":\"...\"}",
        "chat": "{\"chat_id\":2, \"chat_name\":\"...\"}"
      }
    },
    "note": "Отправляется новому участнику и всем текущим членам чата."
  },
  {
    "method": "Исключение участника",
    "request": {
      "command": "kick_member",
      "sender_id": "1",
      "args": { "user_id": "5", "chat_id": "2" }
    },
    "response": {
      "command": "kicked_from_chat",
      "args": { 
        "user": "{\"user_id\":5, \"user_name\":\"...\"}",
        "chat": "{\"chat_id\":2, \"chat_name\":\"...\"}"
      }
    }
  },
  {
    "method": "Отправка сообщения",
    "request": {
      "command": "send_message",
      "sender_id": "1",
      "args": { "chat_id": "2", "body": "hello world!" }
    },
    "response": {
      "command": "message_recive",
      "args": {
        "chat_id": "2",
        "message": "{\"body\":\"hello world!\",\"sender_id\":1,\"send_time\":\"27.04.2026 21:00:00\"}"
      }
    },
    "note": "Рассылается всем участникам чата, кроме отправителя."
  },
  {
    "method": "Вход в систему",
    "request": {
      "command": "login",
      "sender_id": "-1",
      "args": { "user_name": "timbundon", "password": "123" }
    },
    "response": {
      "command": "loged",
      "args": { 
        "user": "{\"user_id\":1, \"user_name\":\"timbundon\", ...}" 
      }
    }
  },
  {
    "method": "Регистрация",
    "request": {
      "command": "register",
      "sender_id": "-1",
      "args": { "user_name": "timbundon", "password": "123" }
    },
    "response": {
      "command": "registered",
      "args": { 
        "user": "{\"user_id\":0, \"user_name\":\"timbundon\", ...}",
        "success": "True" 
      }
    }
  },
  {
    "method": "Получение сообщений чата",
    "request": {
      "command": "get_chat_messages",
      "sender_id": "1",
      "args": { "chat_id": "2" }
    },
    "response": {
      "command": "chat_messsages",
      "args": {
        "chat": "{\"chat_id\":2, \"chat_name\":\"...\"}",
        "messages": "[{\"body\":\"...\",\"sender_id\":1, \"send_time\":\"...\"}]"
      }
    }
  },
  {
    "method": "Получение списка участников",
    "request": {
      "command": "get_chat_members",
      "sender_id": "1",
      "args": { "chat_id": "2" }
    },
    "response": {
      "command": "chat_members",
      "args": {
        "chat": "{\"chat_id\":2, \"chat_name\":\"...\"}",
        "members": "[{\"user_id\":1,\"user_name\":\"...\"}]"
      }
    }
  },
  {
    "method": "Получение данных пользователя",
    "request": {
      "command": "get_user",
      "sender_id": "1",
      "args": { "user_id": "2" }
    },
    "response": {
      "command": "user",
      "args": {
        "user": "{\"user_id\":2, \"user_name\":\"...\"}"
      }
    }
  },
  {
    "method": "Получение данных чата",
    "request": {
      "command": "get_chat",
      "sender_id": "1",
      "args": { "chat_id": "2" }
    },
    "response": {
      "command": "chat",
      "args": {
        "chat": "{\"chat_id\":2, \"chat_name\":\"...\"}"
      }
    }
  },
  {
    "method": "Получение чатов пользователя",
    "request": {
      "command": "get_user_chats",
      "sender_id": "1",
      "args": { "user_id": "1" }
    },
    "response": {
      "command": "user_chats",
      "args": {
        "user": "{\"user_id\":1, \"user_name\":\"...\"}",
        "chats": "[{\"chat_id\":1, \"chat_name\":\"...\"}]"
      }
    }
  }
]